{
    "AllowedHosts": "*",
    "Environment": "local",
    "Logging": {
        "LogLevel": {
            "Default": "Debug",
            "System": "Information",
            "Microsoft": "Information"
        }
    },
    "OpenTelemetry": {
        "CaptureBody": {
            "EnableForAll": false,
            "Tenants": []
        },
        "Exporters": {
            "OtelCollector": {
                "EndpointAddress": "http://localhost:4317",
                "Enabled": true
            }
        }
    },
    "MassTransit": {
        "QueueName": "MassTransitSample.Orders",
        "ErrorQueueName": "MassTransitSample.Errors",
        "RabbitMq": {
            "Url": "amqp://guest:guest@localhost:5672/"
        },
        "MaximumConcurrencyLevel": 40,
        "NumberOfRetries": 2
    }
}